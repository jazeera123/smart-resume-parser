# Supabase configuration — copy this file to `.env` and fill in your project's values.
# Create a free Supabase project at https://supabase.com and find these in:
#   Project Settings → API
#
# VITE_SUPABASE_URL is your project URL (e.g. https://yourproject.supabase.co)
# VITE_SUPABASE_ANON_KEY is the "anon public" API key
#
# After creating the project, run the SQL migration in
# supabase/migrations/20261118093437_create_candidates_table.sql
# using the Supabase SQL Editor to create the candidates table.

VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
